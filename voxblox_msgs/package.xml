<?xml version="1.0"?>
<package format="3">
  <name>voxblox_msgs</name>
  <version>0.0.0</version>
  <description>Message definitions for the Voxblox ROS2 interface.</description>

  <maintainer email="helen.oleynikova@mavt.ethz.ch">Helen Oleynikova</maintainer>
  <maintainer email="marius.fehr@mavt.ethz.ch">Marius Fehr</maintainer>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>


  <build_depend>nav_msgs</build_depend>
  <exec_depend>nav_msgs</exec_depend>
   <export>
   <build_type>ament_cmake</build_type>
 </export>

</package>
